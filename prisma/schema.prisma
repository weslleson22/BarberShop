// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  email       String   @unique
  phone       String?
  address     String?
  logo        String?
  description String?
  isActive          Boolean   @default(true)
  status            String    @default("APPROVED")
  contractExpiresAt DateTime?
  trialEndsAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdById String?
  creator     User?    @relation("BarbershopCreator", fields: [createdById], references: [id])

  // Relations
  users     User[]
  clients   Client[]
  services  Service[]
  appointments Appointment[]
  payments  Payment[]
  subscriptions Subscription[]
  invoices      Invoice[]
  slugRedirects BarbershopSlugRedirect[]
  privacyRequests PrivacyRequest[]
  feedbacks     TenantFeedback[]
  auditLogs     AuditLog[]

  @@map("barbershops")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        UserRole @default(CLIENT)
  avatar      String?
  phone       String?
  address     String?
  birthDate   DateTime?
  bio         String?
  specialties String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Relations
  appointments Appointment[]
  createdAppointments Appointment[] @relation("AppointmentCreator")
  createdBarbershops  Barbershop[]  @relation("BarbershopCreator")
  client       Client?
  notifications Notification[]
  privacyRequests PrivacyRequest[]
  feedbacks     TenantFeedback[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  avatar      String?
  notes       String?
  isActive    Boolean  @default(true)
  isVip       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Conta de login vinculada (quando o cliente também é um usuário do sistema, role CLIENT)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  appointments Appointment[]

  @@unique([email, barbershopId])
  @@map("clients")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      // Duration in minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Relations
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id            String           @id @default(cuid())
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String?
  totalAmount   Decimal          @db.Decimal(10, 2)
  isVip         Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Multi-tenant
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  barberId String
  barber   User @relation(fields: [barberId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdBy String?
  creator   User? @relation("AppointmentCreator", fields: [createdBy], references: [id])

  payments Payment[]

  @@index([barbershopId, barberId, startTime, endTime])
  @@index([barbershopId, startTime, status])
  @@map("appointments")
}

model Payment {
  id            String      @id @default(cuid())
  amount        Decimal     @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Multi-tenant
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Relations
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum UserRole {
  DEVELOPER
  ADMIN
  BARBER
  RECEPTIONIST
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

// ==========================================
// DOMÍNIO DE ASSINATURAS DO SAAS (B2B BILLING)
// Não confundir com Payment (atendimento operacional)
// ==========================================

model Plan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("BRL")
  billingInterval BillingInterval @default(MONTHLY)
  trialDays       Int             @default(0)
  isActive        Boolean         @default(true)
  features        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  barbershopId           String
  barbershop             Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  trialStart             DateTime?
  trialEnd               DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  provider               String?
  providerSubscriptionId String?
  providerCustomerId     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices               Invoice[]
  events                 SubscriptionEvent[]

  @@index([barbershopId, status])
  @@index([status])
  @@index([providerSubscriptionId])
  @@index([providerCustomerId])
  @@map("subscriptions")
}

model Invoice {
  id                String        @id @default(cuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  barbershopId      String
  barbershop        Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("BRL")
  status            InvoiceStatus @default(OPEN)
  dueDate           DateTime
  paidAt            DateTime?
  provider          String?
  providerInvoiceId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([barbershopId, status])
  @@index([subscriptionId, status])
  @@index([dueDate])
  @@map("invoices")
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           SubscriptionEventType
  payload        Json                  @default("{}")
  createdAt      DateTime              @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  eventType   String
  payload     Json     @default("{}")
  processedAt DateTime @default(now())
  status      String   @default("PROCESSED")

  @@index([provider, eventId])
  @@map("processed_webhooks")
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  CANCELED
}

enum SubscriptionEventType {
  TRIAL_STARTED
  TRIAL_7_DAYS_REMAINING
  TRIAL_3_DAYS_REMAINING
  TRIAL_1_DAY_REMAINING
  TRIAL_EXPIRED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWED
  PLAN_CHANGED
}

model BarbershopSlugRedirect {
  id           String      @id @default(cuid())
  barbershopId String
  oldSlug      String      @unique
  createdAt    DateTime    @default(now())

  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("barbershop_slug_redirects")
}

model PrivacyRequest {
  id              String               @id @default(cuid())
  userId          String?
  barbershopId    String?
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(PENDING)
  applicantEmail  String
  applicantName   String
  details         String?
  rejectionReason String?
  processedAt     DateTime?
  processedById   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  barbershop      Barbershop?          @relation(fields: [barbershopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([barbershopId])
  @@index([applicantEmail])
  @@map("privacy_requests")
}

enum PrivacyRequestType {
  ACCESS
  EXPORT
  RECTIFICATION
  ANONYMIZATION
  DELETION
  REVOCATION
}

enum PrivacyRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

model TenantFeedback {
  id                String      @id @default(cuid())
  barbershopId      String?
  barbershop        Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName          String?
  userEmail         String?
  easeScore         Int         // 1-5 (Facilidade de uso)
  satisfactionScore Int         // 1-5 (Satisfação geral / CSAT)
  mostUsedFeature   String?     // Funcionalidade mais utilizada
  missingFeature    String?     // Funcionalidade que faz falta
  problems          String?     // Problemas enfrentados
  bugsReported      String?     // Bugs reportados
  continueIntent    String      // "YES", "NO", "MAYBE"
  notes             String?
  createdAt         DateTime    @default(now())

  @@index([barbershopId])
  @@index([createdAt])
  @@map("tenant_feedbacks")
}

// ==========================================
// DOMÍNIO DE AUDITORIA
// Rastreamento de ações relevantes dos usuários
// NUNCA registrar: senha, token, JWT, secrets
// ==========================================

model AuditLog {
  id           String      @id @default(cuid())

  // Quem realizou a ação (null = sistema/automatizado)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contexto Multi-Tenant (null = ação global, ex: DEVELOPER)
  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)

  // O que foi feito
  action       AuditAction

  // Em qual entidade
  entity       AuditEntity
  entityId     String?     // ID do registro afetado

  // Contexto da requisição (nunca armazenar dados sensíveis)
  ipAddress    String?     // IP do cliente (anonimizado se necessário)
  userAgent    String?     // Browser/client info

  // Dados adicionais relevantes (sanitizados — sem senha, token, JWT)
  metadata     Json        @default("{}")

  // Status da operação
  success      Boolean     @default(true)
  errorMessage String?     // Mensagem de erro, se houver

  createdAt    DateTime    @default(now())

  // Índices para consultas frequentes
  @@index([userId, createdAt])
  @@index([barbershopId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  // Autenticação
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED

  // CRUD genérico
  CREATE
  UPDATE
  DELETE
  VIEW

  // Agendamentos
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW

  // Usuários e equipe
  USER_INVITED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_ROLE_CHANGED

  // Clientes
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED

  // Serviços
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED

  // Assinatura/Billing
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_SUSPENDED
  TRIAL_STARTED
  TRIAL_EXPIRED
  PAYMENT_RECEIVED
  PAYMENT_FAILED

  // LGPD
  PRIVACY_REQUEST_CREATED
  PRIVACY_REQUEST_PROCESSED
  DATA_EXPORTED
  DATA_DELETED

  // Administração (DEVELOPER)
  BARBERSHOP_APPROVED
  BARBERSHOP_SUSPENDED
  BARBERSHOP_CREATED
  PLAN_CREATED
  PLAN_UPDATED

  // Webhooks
  WEBHOOK_RECEIVED
  WEBHOOK_PROCESSED
  WEBHOOK_FAILED
}

enum AuditEntity {
  USER
  BARBERSHOP
  CLIENT
  SERVICE
  APPOINTMENT
  PAYMENT
  SUBSCRIPTION
  INVOICE
  SUBSCRIPTION_EVENT
  PLAN
  NOTIFICATION
  PRIVACY_REQUEST
  TENANT_FEEDBACK
  WEBHOOK
  SYSTEM
}
